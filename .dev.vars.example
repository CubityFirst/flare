# Copy to .dev.vars for local development. Only secrets declared with
# bindings.secret() in cloudflare.config.ts are read from this file.

# Signs the short-lived OIDC login cookie. Any long random string.
SESSION_SECRET=
# Web Push key pair. Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# The cubityfir.st OIDC client secret (in the gitignored .oidc.secrets). Leave it out to
# use the local dev sign-in instead of real OIDC.
# OIDC_CLIENT_SECRET=
